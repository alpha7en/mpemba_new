\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Spatial maps of local excitability $B(k, i)$ for the first three non-trivial relaxation modes on the selected $6 \times 6$ test lattice ($p = 0.15$). The color mapping and node representation conventions strictly follow those detailed in Fig.~\ref {fig:excib_maps_represent}. Note the pronounced spatial localization of the fundamental mode ($k=1$), which provides the geometric basis for our state-engineering algorithm.}}{22}{figure.caption.12}\protected@file@percent }
\newlabel{fig:step1}{{11}{22}{Spatial maps of local excitability $B(k, i)$ for the first three non-trivial relaxation modes on the selected $6 \times 6$ test lattice ($p = 0.15$). The color mapping and node representation conventions strictly follow those detailed in Fig.~\ref {fig:excib_maps_represent}. Note the pronounced spatial localization of the fundamental mode ($k=1$), which provides the geometric basis for our state-engineering algorithm}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Step 2: Selection hot state (Dark node)}{22}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Step 3: Selection cold state (Mix of bright nodes)}{23}{subsection.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Deterministic selection of the Mpemba pair based on the $k=1$ excitability map from Fig.~\ref {fig:step1}. \textbf  {(A)} The localized "hot" state is placed at the darkest node (red outline), minimizing its interaction with the slow mode. \textbf  {(B)} The mixed "cold" state is distributed across the $M=3$ brightest nodes (blue outlines), identified as the optimal combination maximizing the heuristic score.}}{23}{figure.caption.13}\protected@file@percent }
\newlabel{fig:step_hot_cold_selection}{{12}{23}{Deterministic selection of the Mpemba pair based on the $k=1$ excitability map from Fig.~\ref {fig:step1}. \textbf {(A)} The localized "hot" state is placed at the darkest node (red outline), minimizing its interaction with the slow mode. \textbf {(B)} The mixed "cold" state is distributed across the $M=3$ brightest nodes (blue outlines), identified as the optimal combination maximizing the heuristic score}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Monte Carlo Benchmark and Applicability Limits}{23}{subsection.8.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Statistical validation of the deterministic algorithm. The histogram displays the distribution of crossing times ($t^*$) for 10,000 randomly generated valid pairs of diagonal initial states on the $6 \times 6$ network ($p=0.15$). The vertical dashed red line marks the extremely short crossing time ($t^* = 44.72$) achieved by the deterministically engineered pair from Fig.~\ref {fig:step_hot_cold_selection}. The algorithmic pair drastically outperforms the vast majority of random configurations, sitting in the extreme left tail of the distribution.}}{24}{figure.caption.14}\protected@file@percent }
\newlabel{fig:algorithm_test}{{13}{24}{Statistical validation of the deterministic algorithm. The histogram displays the distribution of crossing times ($t^*$) for 10,000 randomly generated valid pairs of diagonal initial states on the $6 \times 6$ network ($p=0.15$). The vertical dashed red line marks the extremely short crossing time ($t^* = 44.72$) achieved by the deterministically engineered pair from Fig.~\ref {fig:step_hot_cold_selection}. The algorithmic pair drastically outperforms the vast majority of random configurations, sitting in the extreme left tail of the distribution}{figure.caption.14}{}}
