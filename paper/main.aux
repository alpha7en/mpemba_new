\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Representative Liouvillian spectra for rewired $10\times 10$ lattices at increasing disorder levels ($p=0$, $p=0.1$, $p=0.3$). The regular lattice exhibits a structured spectrum with degeneracies tied to symmetry; rewiring lifts degeneracies and progressively smears spectral branches. The eigenvalues closest to zero (rightmost points) correspond to the slowest relaxation modes.}}{14}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rewired_spectra}{{5}{14}{Representative Liouvillian spectra for rewired $10\times 10$ lattices at increasing disorder levels ($p=0$, $p=0.1$, $p=0.3$). The regular lattice exhibits a structured spectrum with degeneracies tied to symmetry; rewiring lifts degeneracies and progressively smears spectral branches. The eigenvalues closest to zero (rightmost points) correspond to the slowest relaxation modes}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Analysis of Slow Modes}{14}{subsection.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Dependence of the relaxation rates on the rewiring probability $p$ (in log. scale) for a $10 \times 10$ lattice. Panels display the real parts of the eigenvalues $\operatorname  {Re}(\lambda _k)$ for the three nontrivial slowest modes ($k=1, 2, 3$). Last panel illustrates the spectral gap $\Delta = \operatorname  {Re}(\lambda _1) - \operatorname  {Re}(\lambda _2)$.}}{15}{figure.caption.7}\protected@file@percent }
\newlabel{fig:modes_log_scale}{{6}{15}{Dependence of the relaxation rates on the rewiring probability $p$ (in log. scale) for a $10 \times 10$ lattice. Panels display the real parts of the eigenvalues $\operatorname {Re}(\lambda _k)$ for the three nontrivial slowest modes ($k=1, 2, 3$). Last panel illustrates the spectral gap $\Delta = \operatorname {Re}(\lambda _1) - \operatorname {Re}(\lambda _2)$}{figure.caption.7}{}}
